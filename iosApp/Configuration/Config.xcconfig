TEAM_ID=

PRODUCT_NAME=MobTT
PRODUCT_BUNDLE_IDENTIFIER=at.stefanirndorfer.mobtt$(TEAM_ID)$(BUNDLE_ID_SUFFIX)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Fixture links (ADR-0011). A .example placeholder until the domain is registered: it never verifies, so no link
// reaches the app. Replace it together with AppConfig.linksHost and the Android linksHost placeholder.
LINKS_HOST=links.mobtt.example
CODE_SIGN_ENTITLEMENTS=Configuration/MobTT.entitlements

// Untracked secrets (XTTV_API_KEY) and the tip page (SUPPORT_URL); see Secrets.xcconfig.example
#include? "Secrets.xcconfig"
