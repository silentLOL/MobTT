    "consent_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme Nutzungsstatistiken und Absturzberichte zulassen? Sie enthalten nie deinen Namen, deinen Spieler oder Verein oder etwas, das du eingibst. Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow anonymous usage statistics and crash reports? They never include your name, your Player or Club, or anything you type. You can change this any time in Settings."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopustiti anonimnu statistiku korištenja i izvješća o rušenju? Nikad ne sadrže tvoje ime, tvog igrača ili klub, niti išta što upišeš. To možeš promijeniti bilo kada u postavkama."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonim kullanım istatistiklerine ve çökme raporlarına izin verilsin mi? Bunlar asla adını, oyuncunu veya kulübünü ya da yazdığın hiçbir şeyi içermez. Bunu istediğin zaman Ayarlar'dan değiştirebilirsin."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permiți statistici anonime de utilizare și rapoarte de blocare? Ele nu includ niciodată numele tău, jucătorul sau clubul tău ori ceva ce scrii. Poți schimba acest lucru oricând în Setări."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezed az anonim használati statisztikákat és az összeomlási jelentéseket? Ezek soha nem tartalmazzák a nevedet, a játékosodat vagy klubodat, sem semmit, amit beírsz. Ezt bármikor módosíthatod a Beállításokban."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволити анонімну статистику використання та звіти про збої? Вони ніколи не містять твого імені, твого гравця чи клубу або будь-чого, що ти вводиш. Це можна змінити будь-коли в налаштуваннях."
          }
        }
      }
    },
