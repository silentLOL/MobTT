    "club_empty_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Verein, seine Mannschaften und die Ligatabellen erscheinen hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Club, its Teams and the League tables will show up here."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj klub, njegove ekipe i tablice liga pojavit će se ovdje."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulübün, takımları ve lig tabloları burada görünecek."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clubul tău, echipele sale și clasamentele ligilor vor apărea aici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A klubod, a csapatai és a ligatáblázatok itt jelennek meg."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твій клуб, його команди та таблиці ліг з’являться тут."
          }
        }
      }
    },
