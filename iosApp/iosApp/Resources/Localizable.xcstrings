    "player_detail_unavailable_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Spieler ist nicht verfügbar"
          }
        },
        "en" : {
