    "player_detail_rating_history_chart_cd %lld %lld %@ %lld %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratingverlauf: %1$lld ±%2$lld, %3$@ bei der letzten Auswertung. Angezeigte Auswertungen: %4$lld, seit %5$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rating history: %1$lld ±%2$lld, %3$@ at the last Rating update. Rating updates shown: %4$lld, since %5$@."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povijest rejtinga: %1$lld ±%2$lld, %3$@ pri zadnjem ažuriranju rejtinga. Prikazana ažuriranja rejtinga: %4$lld, od %5$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reyting geçmişi: %1$lld ±%2$lld, son reyting güncellemesinde %3$@. Gösterilen reyting güncellemesi: %4$lld, başlangıç: %5$@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istoricul ratingului: %1$lld ±%2$lld, %3$@ la ultima actualizare a ratingului. Actualizări afișate: %4$lld, din %5$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Értékszámtörténet: %1$lld ±%2$lld, %3$@ az utolsó értékszám-frissítéskor. Megjelenített frissítések: %4$lld, kezdete: %5$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історія рейтингу: %1$lld ±%2$lld, %3$@ під час останнього оновлення рейтингу. Показано оновлень рейтингу: %4$lld, починаючи з %5$@."
          }
        }
      }
    },
